# ===========================================================
#  Variables de entorno de Margaritas
# ===========================================================
#
#  CÓMO USARLO
#
#  1. Copiá este archivo a la raíz del proyecto con el nombre .env
#         cp .env.example .env          (Linux / Mac / Git Bash)
#         copy .env.example .env        (CMD de Windows)
#
#  2. Pegá tu API key de Gemini en la línea GEMINI_API_KEY de abajo,
#     después del signo = y SIN comillas ni espacios.
#         GEMINI_API_KEY=AIzaSy...tu-key-real
#
#  3. Reiniciá el server (node server.js) para que la tome.
#
#  El archivo .env está en .gitignore, así que tu key nunca se sube al repo.
# ===========================================================

# API Key de Google Gemini para el asistente de pedidos.
# Se genera gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Puerto del servidor web (default 8080)
PORT=8080

# URL del microservicio del bot de WhatsApp (bot.js)
BOT_URL=http://localhost:8081

# Número de WhatsApp de la tienda que recibe las órdenes (sin + ni espacios)
NUMERO_VENTAS=595971140350

# Secreto para firmar los tokens del panel admin
JWT_SECRET=margaritas-admin-secret-key-123
