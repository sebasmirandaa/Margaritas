# Copiá este archivo como .env y completá los valores.

# API Key de Google Gemini para el asistente de pedidos.
# Si queda vacía, el asistente usa una extracción básica por regex y el pedido igual llega al bot.
GEMINI_API_KEY=

# Puerto del servidor web (default 8080)
PORT=8080

# URL del microservicio del bot de WhatsApp (bot.js)
BOT_URL=http://localhost:8081

# Número de WhatsApp de la tienda que recibe las órdenes (sin + ni espacios)
NUMERO_VENTAS=595994404080

# Secreto para firmar los tokens del panel admin
JWT_SECRET=margaritas-admin-secret-key-123
